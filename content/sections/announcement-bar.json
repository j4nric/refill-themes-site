    "min": 3,
    "max": 10,
    "step": 1,
    "unit": "s",
    "visible_if": [
     {
      "setting": "transition",
      "label": "Transition",
      "op": "is",
      "value": "Vertical (fade upwards)"
     },
     "and",
     {
