 "en": {
  "name": "Scroll story",
  "category": "Media",
  "settings": [
   {
    "type": "paragraph",
    "content": "Slides blend into each other while scrolling; image and text stay in place. Keep texts short: each slide fills the screen. With reduced motion the slides are stacked."
   },
   {
    "type": "header",
    "content": "Animation"
   },
   {
    "type": "select",
    "id": "transition",
    "label": "Transition",
    "default": "zoom",
    "options": [
     {
      "value": "fade",
      "label": "Crossfade"
     },
     {
      "value": "zoom",
      "label": "Crossfade with image zoom"
     },
     {
      "value": "slide",
      "label": "Image slides in"
     }
    ],
    "visible_if": [
     {
      "setting": null,
      "label": "Enable animations",
      "op": "on"
     }
    ]
   },
   {
    "type": "select",
    "id": "pace",
    "label": "Slide change",
    "info": "All at once: the next slide appears in full as soon as it reaches the top – no half-finished states. With scrolling: image and text blend continuously as you scroll (browsers without scroll animations always change all at once).",
    "default": "switch",
    "options": [
     {
      "value": "switch",
      "label": "All at once (recommended)"
     },
     {
      "value": "scrub",
      "label": "With scrolling"
     }
    ],
    "visible_if": [
     {
      "setting": null,
      "label": "Enable animations",
      "op": "on"
     }
    ]
   },
   {
    "type": "select",
    "id": "step",
    "label": "Scroll distance per slide",
    "info": "How far visitors scroll until the next slide is fully shown.",
    "default": "medium",
    "options": [
     {
      "value": "short",
      "label": "Short"
     },
     {
      "value": "medium",
      "label": "Medium"
     },
     {
      "value": "long",
      "label": "Long"
     }
    ],
    "visible_if": [
     {
      "setting": null,
      "label": "Enable animations",
      "op": "on"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "snap",
    "label": "Snap to slides",
    "info": "After scrolling, the page stops on the nearest full slide.",
    "default": true,
    "visible_if": [
     {
      "setting": null,
      "label": "Enable animations",
      "op": "on"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "show_arrows",
    "label": "Up and down arrows",
    "info": "Jump straight to the previous or next slide.",
    "default": true,
    "visible_if": [
     {
      "setting": null,
      "label": "Enable animations",
      "op": "on"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": "Animations are turned off (Theme settings › Animation): slides are stacked, transition and scroll distance do not apply."
   },
   {
    "type": "header",
    "content": "Design"
   },
   {
    "type": "select",
    "id": "media_position",
    "label": "Image (desktop)",
    "default": "start",
    "options": [
     {
      "value": "start",
      "label": "First"
     },
     {
      "value": "end",
      "label": "Last"
     },
     {
      "value": "alternate",
      "label": "Alternating"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "show_index",
    "label": "Number slides (01, 02 …)",
    "default": true
   }
  ]
 },
 "de": {
  "name": "Scroll-Story",
  "category": "Medien",
  "settings": [
   {
    "type": "paragraph",
    "content": "Folien gehen beim Scrollen ineinander über, Bild und Text bleiben dabei stehen. Kurze Texte wählen: jede Folie füllt den Bildschirm. Bei „Bewegung reduzieren“ stehen die Folien untereinander."
   },
   {
    "type": "header",
    "content": "Animation"
   },
   {
    "type": "select",
    "id": "transition",
    "label": "Übergang",
    "default": "zoom",
    "options": [
     {
      "value": "fade",
      "label": "Überblenden"
     },
     {
      "value": "zoom",
      "label": "Überblenden mit Bild-Zoom"
     },
     {
      "value": "slide",
      "label": "Bild gleitet herein"
     }
    ],
    "visible_if": [
     {
      "setting": null,
      "label": "Animationen aktivieren",
      "op": "on"
     }
    ]
   },
   {
    "type": "select",
    "id": "pace",
    "label": "Wechsel",
    "info": "Auf einmal: Die nächste Folie erscheint vollständig, sobald sie oben ankommt – kein halber Zwischenstand. Mit dem Scrollen: Bild und Text gehen stufenlos ineinander über (Browser ohne Scroll-Animationen wechseln immer auf einmal).",
    "default": "switch",
    "options": [
     {
      "value": "switch",
      "label": "Auf einmal (empfohlen)"
     },
     {
      "value": "scrub",
      "label": "Mit dem Scrollen"
     }
    ],
    "visible_if": [
     {
      "setting": null,
      "label": "Animationen aktivieren",
      "op": "on"
     }
    ]
   },
   {
    "type": "select",
    "id": "step",
    "label": "Scrollweg je Folie",
    "info": "Wie weit gescrollt wird, bis die nächste Folie vollständig da ist.",
    "default": "medium",
    "options": [
     {
      "value": "short",
      "label": "Kurz"
     },
     {
      "value": "medium",
      "label": "Mittel"
     },
     {
      "value": "long",
      "label": "Lang"
     }
    ],
    "visible_if": [
     {
      "setting": null,
      "label": "Animationen aktivieren",
      "op": "on"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "snap",
    "label": "An Folien einrasten",
    "info": "Nach dem Scrollen hält die Seite auf der nächsten ganzen Folie.",
    "default": true,
    "visible_if": [
     {
      "setting": null,
      "label": "Animationen aktivieren",
      "op": "on"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "show_arrows",
    "label": "Pfeile hoch und runter",
    "info": "Springen direkt zur vorigen bzw. nächsten Folie.",
    "default": true,
    "visible_if": [
     {
      "setting": null,
      "label": "Animationen aktivieren",
      "op": "on"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": "Animationen sind ausgeschaltet (Theme-Einstellungen › Animation): Die Folien stehen untereinander, Übergang und Scrollweg entfallen."
   },
   {
    "type": "header",
    "content": "Gestaltung"
   },
   {
    "type": "select",
    "id": "media_position",
    "label": "Bild (Desktop)",
    "default": "start",
    "options": [
     {
      "value": "start",
      "label": "Vorne"
     },
     {
      "value": "end",
      "label": "Hinten"
     },
     {
      "value": "alternate",
      "label": "Abwechselnd"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "show_index",
    "label": "Folien nummerieren (01, 02 …)",
    "default": true
   }
  ]
 },
