      "label": "Small"
     },
     {
      "value": "medium",
      "label": "Medium"
     },
     {
      "value": "large",
      "label": "Large"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "borderless",
    "label": "Tiles without border",
    "default": false,
    "visible_if": [
     {
      "setting": "style",
      "label": "Style",
      "op": "is_not",
      "value": "Rows"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "swatch_only",
    "label": "Show swatch only",
