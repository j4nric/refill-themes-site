   },
   {
    "type": "select",
    "id": "pagination",
    "label": "Pagination",
    "default": "pages",
    "options": [
     {
      "value": "pages",
      "label": "Page numbers"
     },
     {
      "value": "load_more",
      "label": "“Load more” button"
     },
     {
      "value": "infinite",
      "label": "Automatically on scroll"
     }
    ]
   },
   {
    "type": "paragraph",
    "content": "“Automatically” loads up to five pages in a row, then the “Load more” button appears again so the footer stays reachable. Without JavaScript, links to the next page are shown."
   }
