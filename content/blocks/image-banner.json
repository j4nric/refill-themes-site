    "default": "ratio",
    "options": [
     {
      "value": "ratio",
      "label": "From aspect ratio"
     },
     {
      "value": "small",
      "label": "Small (a third of the screen)"
     },
     {
      "value": "half",
      "label": "Half the screen"
     },
     {
      "value": "large",
      "label": "Large (three quarters of the screen)"
     }
    ]
   },
