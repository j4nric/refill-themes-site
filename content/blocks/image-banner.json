    "default": "center",
    "options": [
     {
      "value": "center",
      "label": "Center"
     },
     {
      "value": "top",
      "label": "Top"
     },
     {
      "value": "bottom",
      "label": "Bottom"
     },
     {
      "value": "left",
      "label": "Left"
     },
     {
      "value": "right",
      "label": "Right"
     },
     {
      "value": "left top",
      "label": "Top left"
     },
     {
      "value": "right top",
      "label": "Top right"
     },
     {
      "value": "left bottom",
      "label": "Bottom left"
     },
     {
      "value": "right bottom",
      "label": "Bottom right"
     }
    ]
   },
   {
    "type": "select",
    "id": "vertical_alignment",
    "label": "Vertical alignment",
    "default": "center",
    "options": [
     {
      "value": "start",
      "label": "Top"
     },
     {
      "value": "center",
      "label": "Middle"
     },
     {
      "value": "end",
      "label": "Bottom"
     }
    ],
    "visible_if": [
     {
      "setting": "layout",
      "label": "Layout",
      "op": "is_not",
      "value": "Image on top"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "use_color_scheme",
    "label": "Own color scheme for the text panel",
    "info": "Off: the text panel uses the section’s color scheme.",
    "default": false
   },
   {
    "type": "color_scheme",
    "id": "color_scheme",
    "label": "Text panel color scheme",
    "default": "scheme-2",
    "visible_if": [
     {
      "setting": "use_color_scheme",
      "label": "Own color scheme for the text panel",
      "op": "on"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "use_color_scheme",
      "label": "Own color scheme for the text panel",
      "op": "on"
     }
    ]
   },
   {
    "type": "header",
    "content": "Motion"
   },
   {
    "type": "select",
    "id": "parallax",
    "label": "Parallax",
    "info": "The image scrolls a little slower than the page. On works without the theme setting as long as animations are turned on. Never with reduced motion; only in Chrome, Edge and Safari 26.",
    "default": "theme",
    "options": [
     {
      "value": "theme",
      "label": "As in theme settings"
     },
     {
      "value": "on",
      "label": "On"
     },
     {
      "value": "off",
      "label": "Off"
     }
    ]
   },
   {
    "type": "select",
    "id": "text_motion",
    "label": "Text animation in the text area",
    "info": "Automatic: the text appears right away when the image loads immediately (banner at the top), otherwise as in theme settings. Show right away: never delayed, even if the text area starts below the visible area.",
    "default": "auto",
    "options": [
     {
      "value": "auto",
      "label": "Automatic"
     },
     {
      "value": "animate",
      "label": "As in theme settings"
     },
     {
      "value": "static",
      "label": "Show right away"
     }
    ]
   }
  ]
 },
