 "en": {
  "name": "Image with text",
  "category": "Media",
  "settings": [
   {
    "type": "image_picker",
    "id": "image",
    "label": "Image"
   },
   {
    "type": "text",
    "id": "alt",
    "label": "Alternative text",
    "info": "Describes the image for screen readers. Empty: the image's alt text from Shopify.",
    "visible_if": [
     {
      "setting": "image",
      "label": "Image",
      "op": "filled"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "image",
      "label": "Image",
      "op": "filled"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "priority",
    "label": "Load immediately (image at the top of the page)",
    "info": "Turn on only for the first large image on the page.",
    "default": false,
    "visible_if": [
     {
      "setting": "image",
      "label": "Image",
      "op": "filled"
     },
     "or",
     {
      "setting": "video",
      "label": "Video instead of image",
      "op": "filled"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "image",
      "label": "Image",
      "op": "filled"
     },
     "or",
     {
      "setting": "video",
      "label": "Video instead of image",
      "op": "filled"
     }
    ]
   },
   {
    "type": "video",
    "id": "video",
    "label": "Video instead of image",
    "info": "Plays muted on a loop once visible, with a pause button. The image above becomes the still image (before the start and with “Reduce motion”); empty: the video’s preview image. Recommended: under 30 seconds and 10 MB – some browsers load the whole file. With data saver on, only the still image is shown."
   },
   {
    "type": "header",
    "content": "Design"
   },
   {
    "type": "select",
    "id": "layout",
    "label": "Layout",
    "default": "image_left",
    "options": [
     {
      "value": "image_left",
      "label": "Image left"
     },
     {
      "value": "image_right",
      "label": "Image right"
     },
     {
      "value": "image_top",
      "label": "Image on top"
     }
    ]
   },
   {
    "type": "select",
    "id": "aspect_ratio",
    "label": "Aspect ratio",
    "default": "4 / 3",
    "options": [
     {
      "value": "adapt",
      "label": "Original"
     },
     {
      "value": "2 / 3",
      "label": "2 : 3"
     },
     {
      "value": "4 / 5",
      "label": "4 : 5"
     },
     {
      "value": "1 / 1",
      "label": "1 : 1"
     },
     {
      "value": "4 / 3",
      "label": "4 : 3"
     },
     {
      "value": "3 / 2",
      "label": "3 : 2"
     },
     {
      "value": "16 / 9",
      "label": "16 : 9"
     },
     {
      "value": "21 / 9",
      "label": "21 : 9"
     },
     {
      "value": "3 / 1",
      "label": "3 : 1"
     }
