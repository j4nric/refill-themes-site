    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "result_mode",
      "label": "After the last question",
      "op": "is",
      "value": "Show products here"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "show_compare",
    "label": "Show “Compare” checkbox",
    "info": "Only when the “Compare” checkbox is on in theme settings (product cards).",
    "default": true,
    "visible_if": [
     {
      "setting": "result_mode",
      "label": "After the last question",
      "op": "is",
      "value": "Show products here"
     },
     "and",
     {
      "setting": null,
      "label": "“Compare” checkbox on product cards",
      "op": "on"
