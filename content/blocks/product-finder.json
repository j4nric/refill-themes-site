 "en": {
  "name": "Product finder",
  "category": "Forms",
  "settings": [
   {
    "type": "paragraph",
    "content": "Add “Question” blocks for a finder with several steps: each answer sets a filter of the collection (filters from the Search & Discovery app). With “Answer option” blocks it stays one question with links."
   },
   {
    "type": "text",
    "id": "label",
    "label": "Eyebrow text",
    "info": "Text in double square brackets is highlighted, e.g. [[refill]].",
    "default": "Product finder"
   },
   {
    "type": "text",
    "id": "question",
    "label": "Question",
    "info": "Text in double square brackets is highlighted, e.g. [[refill]].",
    "default": "What are you looking for?"
   },
   {
    "type": "select",
    "id": "heading_tag",
    "label": "Heading level (SEO)",
    "default": "h2",
    "options": [
     {
      "value": "h2",
      "label": "H2 – Section"
     },
     {
      "value": "h3",
      "label": "H3 – Subsection"
     },
     {
      "value": "h4",
      "label": "H4 – Minor subsection"
     },
     {
      "value": "p",
      "label": "Normal text"
     }
    ],
    "visible_if": [
     {
      "setting": "question",
      "label": "Question",
      "op": "filled"
     }
    ]
   },
   {
    "type": "header",
    "content": "Questions (several steps)"
   },
   {
    "type": "collection",
    "id": "collection",
    "label": "Collection for the results",
    "info": "Empty = all products. The answers’ filters must be enabled for collections in the Search & Discovery app."
   },
   {
    "type": "select",
    "id": "result_mode",
    "label": "After the last question",
    "default": "redirect",
    "options": [
     {
      "value": "redirect",
      "label": "Open the filtered collection"
     },
     {
      "value": "inline",
      "label": "Show products here"
     }
    ]
   },
   {
    "type": "range",
    "id": "results_limit",
    "label": "Products shown",
    "default": 4,
    "min": 2,
    "max": 8,
    "step": 1,
    "visible_if": [
     {
      "setting": "result_mode",
      "label": "After the last question",
      "op": "is",
      "value": "Show products here"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "result_mode",
      "label": "After the last question",
      "op": "is",
      "value": "Show products here"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "show_profile",
    "label": "Show profile scales (e.g. scent, texture)",
    "info": "Only when “Show profile scales on product cards” is on in theme settings.",
    "default": true,
    "visible_if": [
     {
      "setting": "result_mode",
      "label": "After the last question",
      "op": "is",
      "value": "Show products here"
     },
     "and",
     {
      "setting": null,
      "label": "Show profile scales on product cards",
      "op": "on"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "result_mode",
      "label": "After the last question",
      "op": "is",
      "value": "Show products here"
     }
    ]
   },
   {
