{
 "slug": "image-hotspots",
 "kind": "block",
 "source": "blocks/image-hotspots.liquid",
 "source_sha1": "a602cbddc914",
 "accepts_blocks": true,
 "en": {
  "name": "Shoppable image",
  "category": "Media",
  "settings": [
   {
    "type": "image_picker",
    "id": "image",
    "label": "Image"
   },
   {
    "type": "text",
    "id": "alt",
    "label": "Alternative text",
    "info": "Describes the image for screen readers. Empty: the image's alt text from Shopify.",
    "visible_if": [
     {
      "setting": "image",
      "label": "Image",
      "op": "filled"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "image",
      "label": "Image",
      "op": "filled"
     }
    ]
   },
   {
    "type": "select",
    "id": "aspect_ratio",
    "label": "Aspect ratio",
    "info": "Marker positions refer to the visible image area. With “Original” the whole image is visible.",
    "default": "adapt",
    "options": [
     {
      "value": "adapt",
      "label": "Original"
     },
     {
      "value": "2 / 3",
      "label": "2 : 3"
     },
     {
      "value": "4 / 5",
      "label": "4 : 5"
     },
     {
      "value": "1 / 1",
      "label": "1 : 1"
     },
     {
      "value": "4 / 3",
      "label": "4 : 3"
     },
     {
      "value": "3 / 2",
      "label": "3 : 2"
     },
     {
      "value": "16 / 9",
      "label": "16 : 9"
     },
     {
      "value": "21 / 9",
      "label": "21 : 9"
     },
     {
      "value": "3 / 1",
      "label": "3 : 1"
     }
    ]
   },
   {
    "type": "select",
    "id": "image_position",
    "label": "Image position",
    "info": "Which part stays visible when the image is cropped. A focal point set in Shopify (Content › Files › image) takes priority.",
    "default": "center",
    "options": [
     {
      "value": "center",
      "label": "Center"
     },
     {
      "value": "top",
      "label": "Top"
     },
     {
      "value": "bottom",
      "label": "Bottom"
     },
     {
      "value": "left",
      "label": "Left"
     },
     {
      "value": "right",
      "label": "Right"
     },
     {
      "value": "left top",
      "label": "Top left"
     },
     {
      "value": "right top",
      "label": "Top right"
     },
     {
      "value": "left bottom",
      "label": "Bottom left"
     },
     {
      "value": "right bottom",
      "label": "Bottom right"
     }
    ],
    "visible_if": [
     {
      "setting": "aspect_ratio",
      "label": "Aspect ratio",
      "op": "is_not",
      "value": "Original"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "aspect_ratio",
      "label": "Aspect ratio",
      "op": "is_not",
      "value": "Original"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "show_legend",
    "label": "Show legend",
    "info": "Numbered list for the image: below it on phones, on desktop only with a column layout. Off: dots open their card on the image everywhere – useful when “Add all products to cart” shows the same products.",
    "default": true
   },
   {
    "type": "select",
    "id": "layout",
    "label": "Layout",
    "info": "Columns from a block width of 750 px: the list always sits next to the image, and a marker jumps to its entry. Narrower, the list sits below the image.",
    "default": "stacked",
    "options": [
     {
      "value": "stacked",
      "label": "Image, card at marker"
     },
     {
      "value": "columns_2",
      "label": "2 columns: image and legend"
     },
     {
      "value": "columns_3",
      "label": "3 columns: image across two, legend"
     }
    ],
    "visible_if": [
     {
      "setting": "show_legend",
      "label": "Show legend",
      "op": "on"
     }
    ]
   },
   {
    "type": "select",
    "id": "list_columns",
    "label": "Legend columns",
    "info": "Applies to the legend next to the image and to the “Add all products to cart” list. One column on phones.",
    "default": "1",
    "options": [
     {
      "value": "1",
      "label": "1 column"
     },
     {
      "value": "2",
      "label": "2 columns"
     },
     {
      "value": "3",
      "label": "3 columns"
     }
    ],
    "visible_if": [
     {
      "setting": "look_add",
      "label": "Add all products to cart",
      "op": "on"
     },
     "or",
     {
      "setting": "show_legend",
      "label": "Show legend",
      "op": "on"
     },
     "and",
     {
      "setting": "layout",
      "label": "Layout",
      "op": "is_not",
      "value": "Image, card at marker"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "look_add",
      "label": "Add all products to cart",
      "op": "on"
     },
     "or",
     {
      "setting": "show_legend",
      "label": "Show legend",
      "op": "on"
     },
     "and",
     {
      "setting": "layout",
      "label": "Layout",
      "op": "is_not",
      "value": "Image, card at marker"
     }
    ]
   },
   {
    "type": "color_scheme",
    "id": "color_scheme",
    "label": "Marker color scheme",
    "info": "Markers use the scheme’s accent color, with border and number in “Text on accent”.",
    "default": "scheme-1"
   },
   {
    "type": "select",
    "id": "dot_style",
    "label": "Marker style",
    "info": "Numbers get smaller below a block width of 750 px. “Small dot” covers the least of the image; the list below the image then has no numbers.",
    "default": "number",
    "options": [
     {
      "value": "number",
      "label": "Number"
     },
     {
      "value": "dot",
      "label": "Small dot"
     }
    ]
   },
   {
    "type": "header",
    "content": "Shop the look"
   },
   {
    "type": "checkbox",
    "id": "look_add",
    "label": "Add all products to cart",
    "info": "Lists the products of the markers below the image with checkboxes, options, total price and one button. Sold-out products are shown but cannot be selected.",
    "default": false
   },
   {
    "type": "text",
    "id": "look_heading",
    "label": "Heading",
    "info": "Text in double square brackets is highlighted, e.g. [[refill]].",
    "default": "Shop the look",
    "visible_if": [
     {
      "setting": "look_add",
      "label": "Add all products to cart",
      "op": "on"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "look_add",
      "label": "Add all products to cart",
      "op": "on"
     }
    ]
   },
   {
    "type": "select",
    "id": "look_heading_tag",
    "label": "Heading level (SEO)",
    "default": "h2",
    "options": [
     {
      "value": "h2",
      "label": "H2 – Section"
     },
     {
      "value": "h3",
      "label": "H3 – Subsection"
     },
     {
      "value": "h4",
      "label": "H4 – Minor subsection"
     },
     {
      "value": "p",
      "label": "Normal text"
     }
    ],
    "visible_if": [
     {
      "setting": "look_add",
      "label": "Add all products to cart",
      "op": "on"
     },
     "and",
     {
      "setting": "look_heading",
      "label": "Heading",
      "op": "filled"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "look_add",
      "label": "Add all products to cart",
      "op": "on"
     }
    ]
   }
  ]
 },
