   },
   {
    "type": "select",
    "id": "region",
    "label": "Map area",
    "info": "Automatic: map of Europe if all points are in Europe, otherwise world map, cropped to the points.",
    "default": "fit",
    "options": [
     {
      "value": "fit",
      "label": "Automatic (around all points)"
     },
     {
      "value": "world",
      "label": "World"
     },
     {
      "value": "europe",
      "label": "Europe"
     }
    ]
   },
   {
    "type": "select",
    "id": "layout",
