 "en": {
  "name": "Decoration",
  "category": "Media",
  "settings": [
   {
    "type": "paragraph",
    "content": "Line motif or your own graphic, placed freely over or behind the area this block sits in. Decorative only: it moves nothing and screen readers skip it. With Reduce motion it stays still."
   },
   {
    "type": "select",
    "id": "motif",
    "label": "Motif",
    "default": "swash",
    "options": [
     {
      "value": "waves",
      "label": "Waves"
     },
     {
      "value": "cycle",
      "label": "Cycle (arrow ring)"
     },
     {
      "value": "contours",
      "label": "Contour lines"
     },
     {
      "value": "path_dots",
      "label": "Path with dots"
     },
     {
      "value": "connector",
      "label": "Connector line"
     },
     {
      "value": "swash",
      "label": "Swash (underline)"
     },
     {
      "value": "corners",
      "label": "Frame corners"
     },
     {
      "value": "branch",
      "label": "Branch with leaf veins"
     },
     {
      "value": "steam",
      "label": "Steam curls"
     },
     {
      "value": "drops",
      "label": "Drop with ripples"
     },
     {
      "value": "scale",
      "label": "Measuring scale"
     },
     {
      "value": "orbit",
      "label": "Orbit"
     },
     {
      "value": "arrow",
      "label": "Curved arrow"
     }
    ],
    "visible_if": [
     {
      "setting": "image",
      "label": "Own graphic",
      "op": "empty"
     }
    ]
   },
   {
    "type": "image_picker",
    "id": "image",
    "label": "Own graphic",
    "info": "Optional. SVG or PNG from Files, replaces the motif. Only the motions Drift and Rotate apply to it."
   },
   {
    "type": "checkbox",
    "id": "image_tint",
    "label": "Show graphic in the selected color",
    "info": "For single-color graphics with a transparent background.",
    "default": false,
    "visible_if": [
     {
      "setting": "image",
      "label": "Own graphic",
      "op": "filled"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "image",
      "label": "Own graphic",
      "op": "filled"
     }
    ]
   },
   {
    "type": "header",
    "content": "Position and size"
   },
   {
    "type": "select",
    "id": "placement",
    "label": "Placement",
    "info": "Free: position in percent of the area (section, group or column); overhang is cut off at its edge. In content: takes up space like a line art block.",
    "default": "overlay",
    "options": [
     {
      "value": "overlay",
      "label": "Free"
     },
     {
      "value": "flow",
      "label": "In content"
     }
    ]
   },
   {
    "type": "select",
    "id": "layer",
    "label": "Layer",
    "default": "back",
    "options": [
     {
      "value": "back",
      "label": "Behind the content"
     },
     {
      "value": "front",
      "label": "In front of the content"
     }
    ],
    "visible_if": [
     {
      "setting": "placement",
      "label": "Placement",
      "op": "is",
      "value": "Free"
     }
    ]
   },
   {
    "type": "range",
    "id": "x",
    "label": "Horizontal",
    "default": 85,
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "%",
    "visible_if": [
     {
      "setting": "placement",
      "label": "Placement",
      "op": "is",
      "value": "Free"
     }
    ]
   },
   {
    "type": "range",
    "id": "y",
    "label": "Vertical",
    "default": 20,
    "min": 0,
    "max": 100,
    "step": 1,
    "unit": "%",
    "visible_if": [
     {
      "setting": "placement",
      "label": "Placement",
      "op": "is",
      "value": "Free"
     }
    ]
   },
   {
    "type": "checkbox",
    "id": "inherit_alignment",
    "label": "Use group alignment",
    "info": "Only inside a group: the block follows its alignment. Outside a group, or with this off, the block’s own alignment below applies. [Learn more](https://refill-themes.com/docs/sections-and-blocks/#group-and-columns)",
    "default": true,
    "visible_if": [
     {
      "setting": "placement",
      "label": "Placement",
      "op": "is",
      "value": "In content"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "placement",
      "label": "Placement",
      "op": "is",
      "value": "In content"
     }
    ]
   },
