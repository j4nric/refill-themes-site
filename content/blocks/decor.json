     },
     {
      "value": "accent_2",
      "label": "Brand color: accent 2"
     },
     {
      "value": "sale",
      "label": "Brand color: promotion / sale"
     },
     {
      "value": "highlight",
      "label": "Brand color: highlight"
     },
     {
      "value": "success",
      "label": "Brand color: success / seal"
     }
    ]
   },
