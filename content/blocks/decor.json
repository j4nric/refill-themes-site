    "options": [
     {
      "value": "start",
      "label": "Left"
     },
     {
      "value": "center",
      "label": "Center"
     },
     {
      "value": "end",
      "label": "Right"
     }
    ],
    "visible_if": [
     {
      "setting": "placement",
      "label": "Placement",
      "op": "is",
      "value": "In content"
     }
    ],
    "hidden_by_default": true,
    "hidden_by": [
     {
      "setting": "placement",
      "label": "Placement",
      "op": "is",
      "value": "In content"
     }
    ]
   },
   {
    "type": "range",
    "id": "width",
    "label": "Size",
    "info": "Width in percent of the area. The height follows the motif.",
    "default": 30,
    "min": 5,
    "max": 100,
    "step": 5,
    "unit": "%"
